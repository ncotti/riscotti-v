`ifndef ISA_H_
`define ISA_H_

package isa;

timeunit 1ns; timeprecision 1ns;

localparam OPCODE_WIDTH = 7;
localparam FUNCT3_WIDTH = 3;
localparam FUNCT7_WIDTH = 7;
localparam OP_WIDTH = OPCODE_WIDTH + FUNCT3_WIDTH + FUNCT7_WIDTH;

typedef enum logic [OP_WIDTH-1:0] {
    OP_ADD = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h0), OPCODE_WIDTH'(8'b0110011)},
    OP_SUB = {FUNCT7_WIDTH'(8'h20), FUNCT3_WIDTH'(4'h0), OPCODE_WIDTH'(8'b0110011)},
    OP_XOR = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h4), OPCODE_WIDTH'(8'b0110011)},
    OP_OR = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h6), OPCODE_WIDTH'(8'b0110011)},
    OP_AND = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h7), OPCODE_WIDTH'(8'b0110011)},
    OP_SLL = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h1), OPCODE_WIDTH'(8'b0110011)},
    OP_SRL = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h5), OPCODE_WIDTH'(8'b0110011)},
    OP_SRA = {FUNCT7_WIDTH'(8'h20), FUNCT3_WIDTH'(4'h5), OPCODE_WIDTH'(8'b0110011)},
    OP_SLT = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h2), OPCODE_WIDTH'(8'b0110011)},
    OP_SLTU = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h3), OPCODE_WIDTH'(8'b0110011)},

    OP_ADDI = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h0), OPCODE_WIDTH'(8'b0010011)},
    OP_XORI = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h4), OPCODE_WIDTH'(8'b0010011)},
    OP_ORI = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h6), OPCODE_WIDTH'(8'b0010011)},
    OP_ANDI = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h7), OPCODE_WIDTH'(8'b0010011)},
    OP_SLLI = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h1), OPCODE_WIDTH'(8'b0010011)},
    OP_SRLI = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h5), OPCODE_WIDTH'(8'b0010011)},
    OP_SRAI = {FUNCT7_WIDTH'(8'h20), FUNCT3_WIDTH'(4'h5), OPCODE_WIDTH'(8'b0010011)},
    OP_SLTI = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h2), OPCODE_WIDTH'(8'b0010011)},
    OP_SLTIU = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h3), OPCODE_WIDTH'(8'b0010011)},

    OP_LB = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h0), OPCODE_WIDTH'(8'b0000011)},
    OP_LH = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h1), OPCODE_WIDTH'(8'b0000011)},
    OP_LW = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h2), OPCODE_WIDTH'(8'b0000011)},
    OP_LBU = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h4), OPCODE_WIDTH'(8'b0000011)},
    OP_LHU = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h5), OPCODE_WIDTH'(8'b0000011)},

    OP_SB = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h0), OPCODE_WIDTH'(8'b0100011)},
    OP_SH = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h1), OPCODE_WIDTH'(8'b0100011)},
    OP_SW = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h2), OPCODE_WIDTH'(8'b0100011)},

    OP_BEQ = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h0), OPCODE_WIDTH'(8'b1100011)},
    OP_BNE = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h1), OPCODE_WIDTH'(8'b1100011)},
    OP_BLT = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h4), OPCODE_WIDTH'(8'b1100011)},
    OP_BGE = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h5), OPCODE_WIDTH'(8'b1100011)},
    OP_BLTU = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h6), OPCODE_WIDTH'(8'b1100011)},
    OP_BGEU = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h7), OPCODE_WIDTH'(8'b1100011)},

    OP_JAL = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h0), OPCODE_WIDTH'(8'b1101111)},
    OP_JALR = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h0), OPCODE_WIDTH'(8'b1100111)},

    OP_LUI = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h0), OPCODE_WIDTH'(8'b0110111)},
    OP_AUIPC = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h0), OPCODE_WIDTH'(8'b0010111)},

    OP_ECALL = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h0), OPCODE_WIDTH'(8'b1110011)},
    OP_EBREAK = {FUNCT7_WIDTH'(8'h01), FUNCT3_WIDTH'(4'h0), OPCODE_WIDTH'(8'b1110011)},
    OP_FENCE = {FUNCT7_WIDTH'(8'h00), FUNCT3_WIDTH'(4'h0), OPCODE_WIDTH'(8'b0001111)},

    OP_MUL = {FUNCT7_WIDTH'(8'h01), FUNCT3_WIDTH'(4'h0), OPCODE_WIDTH'(8'b0110011)},
    OP_MULH = {FUNCT7_WIDTH'(8'h01), FUNCT3_WIDTH'(4'h1), OPCODE_WIDTH'(8'b0110011)},
    OP_MULHSU = {FUNCT7_WIDTH'(8'h01), FUNCT3_WIDTH'(4'h2), OPCODE_WIDTH'(8'b0110011)},
    OP_MULHU = {FUNCT7_WIDTH'(8'h01), FUNCT3_WIDTH'(4'h3), OPCODE_WIDTH'(8'b0110011)},
    OP_DIV = {FUNCT7_WIDTH'(8'h01), FUNCT3_WIDTH'(4'h4), OPCODE_WIDTH'(8'b0110011)},
    OP_DIVU = {FUNCT7_WIDTH'(8'h01), FUNCT3_WIDTH'(4'h5), OPCODE_WIDTH'(8'b0110011)},
    OP_REM = {FUNCT7_WIDTH'(8'h01), FUNCT3_WIDTH'(4'h6), OPCODE_WIDTH'(8'b0110011)},
    OP_REMU = {FUNCT7_WIDTH'(8'h01), FUNCT3_WIDTH'(4'h7), OPCODE_WIDTH'(8'b0110011)}
} op_t;

endpackage: isa


`endif // ISA_H_
